# Switch server (the agent bridge base URL; `GET /health` must answer 200)
SWITCH_URL=http://localhost:8000

# Registration API key from the Switch Gateway (API Keys page, type "registration").
# Used once by `npm run register`; the agents' own API keys are stored in .said/secrets.json.
SWITCH_REGISTRATION_KEY=

# The Switch room id (UUID) Said and the builder work in. `npm run doctor` lists your rooms.
SAID_ROOM_ID=

# Agent names as registered on Switch
SAID_AGENT_NAME=said
BUILDER_AGENT_NAME=builder

# business (developer + client, with builder) or personal (two partners, no builder)
SAID_MODE=business
# IANA zone for human timestamps in room replies (signed ledger/receipts stay UTC ISO).
SAID_TIMEZONE=America/New_York

# Coding worker for the builder: claude | codex
SAID_WORKER=claude

# Ports
CONSOLE_PORT=7400
NOTARY_PORT=7410
BUILDER_PORT=7420
MOCK_SWITCH_PORT=7500
CLIENT_SITE_PORT=5173

# Optional shared secret for local notary/builder HTTP APIs (Bearer or X-Said-Shared-Secret).
# Leave blank when only the console on this machine talks to them (they bind 127.0.0.1).
SAID_HTTP_SHARED_SECRET=

# --- Platform bridges via Switch (do NOT build separate bots) ---
# Slack: create a Slack app with bot token, then connect it in Switch Console → Messaging apps → Slack.
# Provide the bot token to Switch, not to Said. Said only needs SWITCH_URL + room id.
# SLACK_BOT_TOKEN=xoxb-...   # used by Switch Console / Switch server, not by Said processes
#
# Telegram: create a bot with BotFather, then connect it in Switch Console → Messaging apps → Telegram.
# TELEGRAM_BOT_TOKEN=123456:ABC...  # used by Switch, not by Said processes
#
# Free tiers only. Said talks to Switch; Switch bridges Slack/Telegram/Mattermost/Discord/Teams.
