{
  "name": "said-switch",
  "private": true,
  "version": "0.1.0",
  "description": "Said: a bilateral consent notary for Switch rooms. Work starts only when both people accept the same terms.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ensure:demo-client": "node scripts/ensure-demo-client.mjs",
    "pretest": "npm run ensure:demo-client",
    "pretest:coverage": "npm run ensure:demo-client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "setup": "tsx scripts/setup.ts",
    "register": "tsx scripts/register.ts",
    "enroll": "tsx scripts/enroll.ts",
    "doctor": "tsx scripts/doctor.ts",
    "reset": "tsx scripts/reset.ts",
    "dev": "concurrently -k -n notary,builder,console,site -c magenta,yellow,cyan,green \"npm -w @said/notary run dev\" \"npm -w @said/builder run dev\" \"npm -w @said/console run dev\" \"npm --prefix work/client-site run dev\"",
    "demo:offline": "tsx scripts/demo-offline.ts",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "verify": "tsx packages/cli/src/cli.ts",
    "live:e2e": "tsx scripts/live-e2e.ts",
    "demo:room": "tsx scripts/demo-room.ts",
    "demo:fixtures": "tsx scripts/demo-fixtures.ts",
    "demo:services": "tsx scripts/demo-services.ts",
    "witness": "tsx apps/witness/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "bin": {
    "said": "./packages/cli/bin/said.mjs"
  }
}
